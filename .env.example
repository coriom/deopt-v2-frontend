# DeOpt v2 frontend — environment example
#
# This file is the public template. Copy to `.env.local` (gitignored) and
# substitute values for your local development. **NEVER** commit real
# values to git: no production RPC URL, no admin Bearer token, no
# DATABASE_URL, no AWS credentials, no KMS values.

# Trading backend base URL. Point to:
#   http://localhost:3000  → local backend (`cargo run -p deopt-v2-backend`)
#   http://localhost:4010  → prism mock of OpenAPI spec
NEXT_PUBLIC_TRADING_API_BASE_URL=http://localhost:3000

# Expected chain id for the UI. Mainnet is GATED in code; do not set to
# mainnet without M-P7 + external-audit closure.
#   anvil    → 31337
#   sepolia  → 84532 (default for testnet beta)
NEXT_PUBLIC_CHAIN_ENV=sepolia

# PerpMatchingEngine EIP-712 domain address for the current chain.
# Used only when the perps closed-test signing path is active. NO
# hardcoded fallback — leave unset for production/public builds.
NEXT_PUBLIC_PERP_MATCHING_ENGINE_ADDRESS=
