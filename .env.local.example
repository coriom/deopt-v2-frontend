# DeOpt v2 frontend — LOCAL DEV ENVIRONMENT TEMPLATE
#
# Posture: localhost dev only. Public testnet beta (Base Sepolia).
# Copy to `.env.local` (gitignored) for local use; do NOT commit real
# values. **NEVER mainnet.**

# --- Trading API base URL (public reads against the backend) ---
# Default points at the local backend started by
# `scripts/local-backend.sh`.
NEXT_PUBLIC_TRADING_API_BASE_URL=http://localhost:8080

# --- Expected chain ---
# Refuses to default to mainnet (see `src/lib/chains.ts`); always
# Sepolia in this beta.
NEXT_PUBLIC_CHAIN_ENV=sepolia

# --- Admin dashboard backend URL (OPTIONAL) ---
# The /admin route reads this to decide where admin XHRs go. Leave
# UNSET for the public-facing deploy; useful only when you run the
# admin dashboard locally against a backend that has admin endpoints
# enabled. Do NOT paste a real admin bearer token into a browser
# pointed at a public app.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8080
